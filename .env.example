# MongoDB Atlas (required: the app reads all its data from the database)
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/cashpilot

# OAuth (Auth.js)
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Storage for expense receipts (optional; empty = kept in memory only)
CLOUDINARY_URL=
